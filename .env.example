# Halal Quant V1 — copy to .env and adjust (never commit .env)

# --- Backend ---
APP_NAME=Halal Quant API
APP_VERSION=0.2.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STARTING_CASH=100000

# Optional: enable PostgreSQL persistence (requires docker compose up -d postgres)
# DATABASE_URL=postgresql+psycopg://halal_quant:halal_quant_dev@localhost:5432/halal_quant

# --- Frontend ---
# VITE_API_URL=http://localhost:8000